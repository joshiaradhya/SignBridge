# Browser-safe values from Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only secrets. Never expose these with a VITE_ prefix or commit a real value.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string, used only by Drizzle tooling.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
